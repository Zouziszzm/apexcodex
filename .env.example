# Spotify — Now Playing (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback
SPOTIFY_REFRESH_TOKEN=

# GitHub — Project import (optional but recommended for higher API rate limits)
# Create a token at https://github.com/settings/tokens with no scopes (public repo read)
GITHUB_TOKEN=

# Local dev only — reads READMEs from disk instead of the GitHub API.
# Do NOT set this on Vercel. Production always fetches from GitHub.
# GITHUB_LOCAL_REPOS_PATH=/Users/static/Documents/Projects

# Setup:
# 1. Spotify Dashboard → your app → Settings → Redirect URIs — add EXACTLY:
#    http://127.0.0.1:3000/api/spotify/callback
#    (for production also add: https://alfarhaankhan.vercel.app/api/spotify/callback)
# 2. User Management → add your Spotify email (required in Development mode)
# 3. Fill credentials above, restart pnpm dev, visit /api/spotify/login
# 4. Paste refresh token into SPOTIFY_REFRESH_TOKEN and restart again
